@model List<JobFinder.WebApp.ViewModels.JobOffer.JobOfferListVM>

<h2>Firm Offers</h2>

@if (!Model.Any())
{
    <p>Nema dostupnih oglasa.</p>
}
else
{
    <table style="width:100%; border-collapse:collapse; margin-top:20px;">
        <thead>
            <tr>
                <th style="text-align:left;">Naziv</th>
                <th>Lokacija</th>
                <th>Tip</th>
                <th>Action</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var job in Model)
        {
            <tr style="border-bottom:1px solid #ddd;">
                <td>@job.Title</td>
                <td>@job.LocationName</td>
                <td>@job.JobName</td>
                   
                @if (job.IsActive)
                    {

                        <td class="text-center">
                            <form asp-action="EndOffer"
                                  method="post"
                                  class="d-inline">
                                <input type="hidden" name="id" value="@job.IDJobOffer" />
                                <button class="btn btn-success btn-sm">
                                    End Offer
                                </button>
                            </form>
                        </td>

                        <td>Active</td>
                    }
                    else
                    {
                        <td>Nothing</td>
                        <td>Not Active</td>
                        
                    }


                <td>
                    <a href="/Firm/Details/@job.IDJobOffer">Show Applications</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
