@model List<JobFinder.WebApp.ViewModels.JobOffer.JobOfferListVM>

<h2>Job Offers</h2>

<!-- SEARCH BAR -->
<form method="get" asp-action="Index" style="margin-bottom:20px;">
    <input 
        type="text" 
        name="search" 
        value="@ViewBag.Search"
        placeholder="Pretraži oglase..."
        style="padding:6px; width:250px;" />

    <button type="submit" style="padding:6px 12px;">Search</button>
</form>

@if (!Model.Any())
{
    <p>Nema dostupnih oglasa.</p>
}
else
{
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="border-bottom:2px solid #000;">
                <th style="text-align:left; padding:8px;">Naziv</th>
                <th style="padding:8px;">Firma</th>
                <th style="padding:8px;">Lokacija</th>
                <th style="padding:8px;">Tip</th>
                <th style="padding:8px;"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var job in Model)
        {
            <tr style="border-bottom:1px solid #ddd;">
                <td style="padding:8px;">@job.Title</td>
                <td style="padding:8px;">@job.FirmName</td>
                <td style="padding:8px;">@job.LocationName</td>
                <td style="padding:8px;">@job.JobName</td>
                <td style="padding:8px;">
                    <a href="/JobOffer/Details/@job.IDJobOffer">Details</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<!-- PAGINATION -->
@if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
{
    <div style="margin-top:20px;">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a 
               href="?search=@ViewBag.Search&page=@i"
               style="margin-right:8px; text-decoration:none;
                      @(ViewBag.Page == i ? "font-weight:bold;" : "")">
                @i
            </a>
        }
    </div>
}
