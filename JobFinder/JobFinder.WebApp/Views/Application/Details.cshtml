@model JobFinder.WebApp.ViewModels.Application.JobApplicationDetailsVM;

<div class="card">

    <h2>@Model.Title</h2>

    <div style="margin-bottom:15px;">
        <strong>Firma:</strong> @Model.FirmName
    </div>

    <div style="margin-bottom:15px;">
        <strong>Status:</strong> @Model.Status
    </div>

    <div style="margin-bottom:15px;">
        <strong>Lokacija:</strong> @Model.LocationName
    </div>

    <div style="margin-bottom:15px;">
        <strong>Tip posla:</strong> @Model.JobName
    </div>

    <div style="margin-bottom:15px;">
        <strong>Salary:</strong> @Model.Salary
    </div>

    <p style="color:#6b7280; margin-bottom:20px;">
        Objavljeno: @Model.CreatedAt.ToString("dd.MM.yyyy")
    </p>

    <p style="color:#6b7280; margin-bottom:20px;">
        Prijavljeno: @Model.AppliedAt.ToString("dd.MM.yyy")
    </p>


    <hr style="margin:25px 0;" />


    <h4>Opis posla</h4>
    <p style="line-height:1.6;">
        @Model.Description
    </p>

    <hr style="margin:25px 0;" />

  

    <div style="margin-top:25px;">
        <a href="/JobOffer">← Povratak na oglase</a>
    </div>

</div>
